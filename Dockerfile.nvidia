ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:13.3.0-devel-ubuntu26.04
ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:13.3.0-runtime-ubuntu26.04
# Pinned by default for reproducible builds; see README "Build" to float.
ARG WHISPER_CPP_REF=5922450fbce1ed9d1648babd0d5ac4520055b436
ARG YT_WHISPER_MODEL=large-v3
# sha256 of ggml-$YT_WHISPER_MODEL.bin (the large-v3 value); empty skips the check.
ARG YT_WHISPER_MODEL_SHA256=64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2
ARG BUILD_JOBS=24
ARG CMAKE_CUDA_ARCHITECTURES
ARG YT_DLP_URL="https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp_linux"
# sha256 of the YT_DLP_URL file; empty skips the check.
ARG YT_DLP_SHA256=767ba9dce7052aa196f8b12652f433d76de128ba168966fa84b6394d5e6c6795

FROM ${BASE_CUDA_DEV_CONTAINER} AS build

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/usr/local/cuda/compat:/usr/local/cuda/lib64

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git bash cmake build-essential pkg-config && \
    rm -rf /var/lib/apt/lists/*

ARG WHISPER_CPP_REF
RUN git init -q /src && \
    cd /src && \
    git fetch -q --depth 1 https://github.com/ggml-org/whisper.cpp.git "$WHISPER_CPP_REF" && \
    git checkout -q --detach FETCH_HEAD && \
    git rev-parse HEAD > /whisper-cpp-revision.txt

ARG YT_WHISPER_MODEL
ARG YT_WHISPER_MODEL_SHA256
RUN mkdir -p "/models/$YT_WHISPER_MODEL" && \
    bash /src/models/download-ggml-model.sh "$YT_WHISPER_MODEL" "/models/$YT_WHISPER_MODEL" && \
    if [ -n "$YT_WHISPER_MODEL_SHA256" ]; then \
      printf '%s  %s\n' "$YT_WHISPER_MODEL_SHA256" "/models/$YT_WHISPER_MODEL/ggml-$YT_WHISPER_MODEL.bin" | sha256sum -c -; \
    fi

ARG BUILD_JOBS
ARG CMAKE_CUDA_ARCHITECTURES
RUN cd /src && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_CUDA=1 -DCMAKE_CUDA_ARCHITECTURES="$CMAKE_CUDA_ARCHITECTURES" && \
    cmake --build build --target whisper-cli -j"$BUILD_JOBS" && \
    mkdir -p /whisper-libs && \
    find /src/build -type f \( -name "libwhisper.so*" -o -name "libggml*.so*" \) -exec cp -av {} /whisper-libs/ \;

FROM ${BASE_CUDA_RUN_CONTAINER}

ARG YT_WHISPER_MODEL
ARG YT_DLP_URL
ARG YT_DLP_SHA256

ENV DEBIAN_FRONTEND=noninteractive
ENV YT_WHISPER_MODEL="${YT_WHISPER_MODEL}"
ENV WHISPER_BACKEND="cuda"
ENV YT_WHISPER_LANG="auto"
ENV YT_WHISPER_NO_GPU="0"

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libgomp1 libstdc++6 && \
    curl -fsSL "$YT_DLP_URL" -o /usr/local/bin/yt-dlp && \
    if [ -n "$YT_DLP_SHA256" ]; then \
      printf '%s  /usr/local/bin/yt-dlp\n' "$YT_DLP_SHA256" | sha256sum -c -; \
    fi && \
    chmod +x /usr/local/bin/yt-dlp && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=build /whisper-libs/ /usr/local/lib/
COPY --from=build /models /models
COPY --from=build /whisper-cpp-revision.txt /usr/local/share/whisper-cpp-revision.txt
COPY yt-whisper /usr/local/bin/yt-whisper

RUN chmod +x /usr/local/bin/whisper-cli /usr/local/bin/yt-whisper && ldconfig

ENTRYPOINT ["/usr/local/bin/yt-whisper"]
